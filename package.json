{
  "name": "html-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/verify-export.mjs",
    "start": "node scripts/serve-out.mjs",
    "lint": "eslint .",
    "test": "TZ=UTC vitest run",
    "test:coverage": "TZ=UTC vitest run --coverage",
    "test:watch": "TZ=UTC vitest",
    "test:mutation": "TZ=UTC stryker run",
    "test:boundary": "node scripts/check-test-boundary.mjs && node scripts/check-layers.mjs && node scripts/check-coverage-ignores.mjs && node scripts/check-hook-rule.mjs",
    "test:integration": "TZ=UTC vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run format:check && npm run test:coverage && npm run test:boundary && npm run test:integration && npm run build",
    "typecheck": "tsc --noEmit",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"content/**/*.ts\" \"scripts/**/*.mjs\" \"tests/**/*.ts\" \"__tests__/**/*.{ts,tsx}\" \"*.md\" \"{docs,src,scripts,tests,content,__tests__}/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"content/**/*.ts\" \"scripts/**/*.mjs\" \"tests/**/*.ts\" \"__tests__/**/*.{ts,tsx}\" \"*.md\" \"{docs,src,scripts,tests,content,__tests__}/**/*.md\""
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "idb-keyval": "^6.3.0",
    "next": "^16.3.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "^16.3.6",
    "playwright": "^1.63.0",
    "prettier": "^3.7.4",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  }
}
